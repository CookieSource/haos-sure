#!/bin/bash
set -euo pipefail
umask 077
[[ -f /run/sure/db-ready ]] || exit 1
mkdir -p /data/backups
file="/data/backups/sure-$(date -u +%Y%m%dT%H%M%SZ).dump"
gosu postgres pg_dump -h /run/postgresql -U postgres -Fc sure_production > "${file}.partial"
mv "${file}.partial" "$file"
find /data/backups -maxdepth 1 -type f -name 'sure-*.dump' -mtime +7 -delete
echo '[sure] Created consistent PostgreSQL backup in /data/backups'
